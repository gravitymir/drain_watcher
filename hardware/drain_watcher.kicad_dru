(version 1)
# Мелкие земляные пады, к которым подведена своя дорожка на via (адрес INA228, земля
# микрофона и т.п.): заливка подходит к ним с одной стороны. Одной тепловой перемычки
# здесь достаточно - соединение идёт ещё и дорожкой.
(rule "one_spoke_small_gnd_pads"
	(condition "A.Type == 'Pad' && A.NetName == 'GND'")
	(constraint min_resolved_spokes 1))
